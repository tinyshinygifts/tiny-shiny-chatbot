PORT=5057
BUSINESS_NAME=Tiny Shiny Gifts
WEBSITE_URL=https://tinyshinygifts.com
WHATSAPP_NUMBER=91XXXXXXXXXX
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX

# Admin login security - change before hosting
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Forgot password DOB format: DD/MM/YYYY
ADMIN_DOB=26/04/1986
SECURITY_SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_SESSION_HOURS=12

# Shopify Admin API - optional but required for live order tracking and draft order creation
SHOPIFY_STORE_DOMAIN=tinyshinygifts.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
CREATE_SHOPIFY_DRAFT_ORDER=false

# WhatsApp Cloud API - optional for owner notification from chatbot
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_TEMPLATE_NAME=
WHATSAPP_TEST_TEMPLATE_LANG=en_US

# Customer WhatsApp follow-up. Keep false until you have customer opt-in and approved WhatsApp template/session rules.
CUSTOMER_WHATSAPP_MESSAGES_ENABLED=false
CUSTOMER_WHATSAPP_TEMPLATE_NAME=
CUSTOMER_WHATSAPP_TEMPLATE_LANG=en

# Security for Shopify webhook. Add later when hosting.
SHOPIFY_WEBHOOK_SECRET=

# Shopify OAuth app credentials - from Shopify Dev Dashboard > Settings
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=https://chat.tinyshinygifts.com
SHOPIFY_OAUTH_REDIRECT_URI=https://chat.tinyshinygifts.com/shopify/callback
SHOPIFY_OAUTH_SCOPES=read_orders,read_products,read_customers,read_draft_orders,write_draft_orders

# Google Sheets CRM auto-save
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=
GOOGLE_SHEET_URL=

# Shiprocket API - optional for tracking status/link
SHIPROCKET_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# iCarry API - optional tracking
ICARRY_ENABLED=false
ICARRY_API_TOKEN=
ICARRY_API_KEY=
ICARRY_CLIENT_ID=
ICARRY_CLIENT_SECRET=
ICARRY_USERNAME=
ICARRY_PASSWORD=
ICARRY_TRACKING_URL=https://www.icarry.in/
